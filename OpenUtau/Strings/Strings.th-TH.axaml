  <system:String x:Key="dawintegration.bpmmismatch">จังหวะของโปรเจกต์ DAW ไม่ตรงกับโปรเจกต์นี้ ไทม์ไลน์ทั้งสองจะตรงกันในระดับวินาทีเท่านั้น แต่ไม่ตรงในระดับห้องเพลง (Bars) — โปรดปรับจังหวะ Tempo ให้ตรงกันเพื่อให้ระบบซิงค์กันอย่างสมบูรณ์</system:String>
  <system:String x:Key="dawintegration.caption">การเชื่อมต่อ DAW (DAW Integration)</system:String>
  <!--<system:String x:Key="dawintegration.col.apiversion">API</system:String>-->
  <system:String x:Key="dawintegration.col.compatibility">สถานะ</system:String>
